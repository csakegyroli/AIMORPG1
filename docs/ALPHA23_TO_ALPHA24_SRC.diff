+.topbar .top-stat{padding:6px 7px;min-width:0;}
+.topbar .top-stat strong{font-size:clamp(11px,1.05vw,15px);overflow-wrap:anywhere;}
+.topbar .top-stat small{font-size:8px;letter-spacing:.7px;}
+.topbar .server-tower-clock{position:relative!important;inset:auto!important;top:auto!important;right:auto!important;transform:none!important;flex:0 0 205px;width:205px!important;min-height:56px!important;height:56px;padding:5px 8px!important;margin:0!important;display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:flex-start!important;gap:8px!important;border:1px solid var(--aim-bronze-patina)!important;border-radius:3px;background:linear-gradient(110deg,#0b1118,#172638)!important;box-shadow:inset 0 0 0 1px #d4af6a14!important;}
+.topbar .server-tower-clock .clock-tower-body{width:44px!important;height:44px!important;flex:0 0 44px!important;}
+.topbar .server-tower-clock .clock-face{width:38px!important;height:38px!important;margin:2px!important;}
+.topbar .server-tower-copy{min-width:0;max-width:none;text-align:left!important;}
+.topbar .server-tower-copy small{font-size:7px;letter-spacing:.5px;white-space:nowrap;}
+.topbar .server-tower-copy strong{display:block;font-size:16px;line-height:1.15;}
+.topbar .server-tower-copy span{display:block;font-size:8px;line-height:1.2;white-space:normal;}
+.nav-icon-eye{display:grid!important;place-items:center;padding:3px;}
+.nav-icon-eye img{display:block;width:24px;height:24px;object-fit:contain;filter:drop-shadow(0 0 5px #3c8fe888);}
+.gm-hero-art-wrap{position:relative;isolation:isolate;min-width:0;width:100%;}
+.gm-hero-art-wrap .gm-hero-art{display:block;width:100%;height:clamp(240px,29vw,380px);object-fit:contain;}
+.eye-gaze-overlay{position:absolute;left:61.5%;top:26.5%;width:clamp(86px,12vw,132px);aspect-ratio:1;border-radius:50%;display:grid;place-items:center;pointer-events:none;transform:translate(calc(-50% + var(--gaze-x,0px)),calc(-50% + var(--gaze-y,0px)));transition:transform var(--gaze-duration,1s) cubic-bezier(.18,.72,.2,1);background:radial-gradient(circle,#8de7ff 0 3%,#40b9ff 9%,#1680e7 20%,#064579 48%,rgba(5,32,63,.84) 65%,transparent 74%);box-shadow:0 0 12px #2999ffcc,0 0 28px #1675d988,inset 0 0 12px #a5e8ff99;mix-blend-mode:screen;}
+.eye-gaze-iris{position:relative;width:76%;height:76%;border-radius:50%;border:2px solid rgba(166,231,255,.94);background:repeating-conic-gradient(from 6deg,#b2eeff99 0deg 2deg,#197ce4 3deg 6deg,#48baffaa 7deg 9deg);box-shadow:inset 0 0 12px #d3f5ff,0 0 9px #4fbaff;display:grid;place-items:center;}
+.eye-gaze-pupil{width:24%;height:46%;border-radius:50%;background:radial-gradient(ellipse at 35% 25%,#122b43,#02070e 68%);box-shadow:0 0 8px #02070e,0 0 7px #5bd0ff;}
+@media(max-width:1250px){.topbar{flex-wrap:wrap;}.topbar .brand{flex:1 1 220px}.topbar .top-stats{order:3;flex:1 1 100%;}.topbar .server-tower-clock{flex:0 0 205px;}}
+@media(max-width:640px){.topbar .server-tower-clock{flex:1 1 100%;width:100%!important;}.topbar .top-stats{grid-template-columns:repeat(2,minmax(0,1fr));}.eye-gaze-overlay{width:clamp(58px,18vw,92px);}}
+@media(prefers-reduced-motion:reduce){.eye-gaze-overlay{transition:none!important;transform:translate(-50%,-50%)!important;}}
