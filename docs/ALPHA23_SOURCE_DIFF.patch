 type EyeViewId = "world" | "memories" | "visions" | "events";
+
+/** A restrained, independently moving magical iris overlay. The underlying observatory artwork remains a flat image. */
+function EyeGazeOverlay() {
+  const [gaze, setGaze] = useState({ x: 0, y: 0, duration: 1.8 });
+  useEffect(() => {
+    const media = window.matchMedia("(prefers-reduced-motion: reduce)");
+    if (media.matches) return;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let cancelled = false;
+    const schedule = () => {
+      const pause = 900 + Math.random() * 2600;
+      timer = setTimeout(() => {
+        if (cancelled) return;
+        // Short, bounded saccades in several directions, occasionally returning near center.
+        const x = Math.random() < 0.16 ? (Math.random() - 0.5) * 2 : (Math.random() - 0.5) * 12;
+        const y = Math.random() < 0.16 ? (Math.random() - 0.5) * 2 : (Math.random() - 0.5) * 8;
+        setGaze({ x, y, duration: 0.55 + Math.random() * 1.15 });
+        schedule();
+      }, pause);
+    };
+    schedule();
+    return () => { cancelled = true; if (timer) clearTimeout(timer); };
+  }, []);
+  return <span className="eye-gaze-overlay" aria-hidden="true" style={{ "--gaze-x": `${gaze.x}px`, "--gaze-y": `${gaze.y}px`, "--gaze-duration": `${gaze.duration}s` } as React.CSSProperties}><span className="eye-gaze-iris"><span className="eye-gaze-pupil" /></span></span>;
+}
