+.capital-world-hero-seal .eye-entity--compact{width:74px;height:50px;}
+.overview-eye{grid-template-columns:minmax(100px,150px) minmax(0,1fr)!important;}
+.overview-eye .eye-entity--compact{width:100%;height:auto;}
+.gm-hero-illustrated .gm-hero-art-wrap{width:100%;min-width:0;}
+.gm-hero-illustrated .eye-entity--scene{width:100%;height:auto;aspect-ratio:3/2;}
+@media(max-width:1250px){
+ .topbar{flex-wrap:nowrap!important;gap:8px!important;padding:8px 10px!important;}
+ .topbar .brand{flex:0 1 185px!important;min-width:145px!important;}
+ .topbar .brand strong{font-size:clamp(15px,1.6vw,21px)!important;letter-spacing:1px!important;}
+ .topbar .brand small{font-size:8px!important;letter-spacing:.6px!important;}
+ .topbar .top-avatar{width:38px!important;height:38px!important;flex:0 0 38px!important;}
+ .topbar .top-stats{order:0!important;flex:1 1 auto!important;width:auto!important;min-width:0!important;grid-template-columns:repeat(4,minmax(45px,.8fr)) minmax(70px,1fr)!important;}
+ .topbar .top-stat{padding:4px 4px!important;}
+ .topbar .top-stat strong{font-size:clamp(10px,1vw,13px)!important;}
+ .topbar .server-tower-clock{order:0!important;flex:0 0 170px!important;width:170px!important;min-width:0!important;height:52px!important;min-height:52px!important;padding:4px 6px!important;gap:5px!important;}
+ .topbar .server-tower-clock .clock-tower-body{width:38px!important;height:38px!important;flex:0 0 38px!important;}
+ .topbar .server-tower-clock .clock-face{width:32px!important;height:32px!important;}
+ .topbar .server-tower-copy strong{font-size:14px!important;}
+ .topbar .server-tower-copy span{font-size:7px!important;}
+}
+@media(max-width:900px){
+ .topbar{display:grid!important;grid-template-columns:minmax(130px,1fr) auto auto;align-items:center!important;}
+ .topbar .brand{grid-column:1;min-width:0!important;}
+ .topbar .top-avatar{grid-column:2;}
+ .topbar .server-tower-clock{grid-column:3;flex:0 0 160px!important;width:160px!important;}
+ .topbar .top-stats{grid-column:1/-1;grid-row:2;display:grid!important;grid-template-columns:repeat(5,minmax(0,1fr))!important;width:100%!important;}
+ .topbar .top-stat small{font-size:7px!important;letter-spacing:0!important;}
+ .topbar .top-stat strong{font-size:11px!important;}
+ .map-eye{right:10px!important;top:10px!important;width:104px!important;}
+ .eye-entity--compact{width:104px;}
+}
+@media(max-width:640px){
+ .topbar{grid-template-columns:minmax(0,1fr) auto!important;gap:7px!important;}
+ .topbar .brand{grid-column:1;}
+ .topbar .top-avatar{display:none!important;}
+ .topbar .server-tower-clock{grid-column:2;grid-row:1;flex:0 0 145px!important;width:145px!important;height:48px!important;min-height:48px!important;}
+ .topbar .server-tower-clock .clock-tower-body{width:34px!important;height:34px!important;flex-basis:34px!important;}
+ .topbar .server-tower-clock .clock-face{width:29px!important;height:29px!important;}
+ .topbar .server-tower-copy small{font-size:6px!important;}
+ .topbar .server-tower-copy strong{font-size:13px!important;}
+ .topbar .server-tower-copy span{font-size:6px!important;}
+ .topbar .top-stats{grid-column:1/-1;grid-row:2;grid-template-columns:repeat(2,minmax(0,1fr))!important;}
+ .topbar .top-stat.wide{display:block!important;}
+ .map-eye{width:86px!important;}
+ .overview-eye{grid-template-columns:100px minmax(0,1fr)!important;gap:10px!important;}
+ .capital-world-hero-seal .eye-entity--compact{width:60px;height:40px;}
+}
+@media(prefers-reduced-motion:reduce){.eye-entity-gaze{transition:none!important;transform:translate(-50%,-50%)!important}.eye-entity-pupil{box-shadow:none!important}}
